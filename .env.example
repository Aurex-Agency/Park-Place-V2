# Copy to .env.local and fill in. Never commit a real key.
#
# Sending is done through Resend on the verified domain
# team.parkplacedentist.com. Only RESEND_API_KEY is required: the other two
# fall back to the values below in code.

# Sending key from the Resend dashboard. Server side only, never exposed to
# the browser, so it deliberately has no NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# Where form submissions land.
CONTACT_TO_EMAIL=apptatppd@gmail.com

# The verified sender. Must stay on the verified domain or Resend rejects it.
CONTACT_FROM_EMAIL=Park Place Dental <support@team.parkplacedentist.com>

# Signs the form token that proves a page was actually loaded.
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_TOKEN_SECRET=

# Separate GHL inbound webhook triggers. Server-side only; never NEXT_PUBLIC_.
# Every successful contact/appointment submission is forwarded, regardless of
# SMS consent. The GHL workflows decide whether a confirmation text is allowed.
GHL_CONTACT_WEBHOOK_URL=
GHL_APPOINTMENT_WEBHOOK_URL=
